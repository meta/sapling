{
  "name": "sapling-scm",
  "displayName": "Sapling SCM",
  "description": "Sapling: A Scalable, User-Friendly Source Control System",
  "version": "0.1.71",
  "publisher": "meta",
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:sapling.open-isl",
    "onWebviewPanel:sapling.isl",
    "onView:sapling.isl"
  ],
  "extensionKind": [
    "workspace"
  ],
  "enabledApiProposals": [
    "contribMultiDiffEditorMenus",
    "editorInsets"
  ],
  "galleryBanner": {
    "color": "#2e8555",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "icon": "resources/extensionIcon.png",
  "homepage": "https://sapling-scm.com/",
  "bugs": {
    "url": "https://github.com/facebook/sapling/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/sapling"
  },
  "contributes": {
    "configuration": {
      "title": "Sapling",
      "properties": {
        "sapling.commandPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%settings.commandPath.description%"
        },
        "sapling.showInlineBlame": {
          "type": "boolean",
          "description": "%settings.showInlineBlame.description%",
          "default": true
        },
        "sapling.showDiffComments": {
          "type": "boolean",
          "description": "%settings.showDiffComments.description%",
          "default": true
        },
        "sapling.inlineCommentDiffViewMode": {
          "type": "string",
          "enum": [
            "Unified",
            "Split"
          ],
          "description": "%settings.diffViewMode.description%",
          "default": "Unified"
        },
        "sapling.markConflictingFilesResolvedOnSave": {
          "type": "boolean",
          "description": "%settings.markConflictingFilesResolvedOnSave.description%",
          "default": true
        },
        "sapling.comparisonPanelMode": {
          "type": "string",
          "enum": [
            "Auto",
            "Always Separate Panel"
          ],
          "enumDescriptions": [
            "%settings.comparisonPanelMode.enumDescriptions.auto%",
            "%settings.comparisonPanelMode.enumDescriptions.always-separate-panel%"
          ],
          "description": "%settings.comparisonPanelMode.description%",
          "default": "Always Separate Panel"
        },
        "sapling.isl.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "%settings.isl.openBeside.description%"
        },
        "sapling.isl.showInSidebar": {
          "type": "boolean",
          "default": false,
          "description": "%settings.isl.showInSidebar.description%"
        },
        "sapling.isl.showOpenOrFocusButtonOnEditorTitle": {
          "type": "boolean",
          "default": true,
          "description": "%settings.isl.showOpenOrFocusButtonOnEditorTitle.description%"
        },
        "sapling.isl.showInlineSignals": {
          "type": "string",
          "enum": [
            "all",
            "errors & warnings",
            "errors",
            "none"
          ],
          "enumDescriptions": [
            "%settings.isl.showInlineSignals.enumDescriptions.all%",
            "%settings.isl.showInlineSignals.enumDescriptions.errorsAndWarnings%",
            "%settings.isl.showInlineSignals.enumDescriptions.errors%",
            "%settings.isl.showInlineSignals.enumDescriptions.none%"
          ],
          "description": "%settings.isl.showInlineSignals.description%",
          "default": "all"
        },
        "sapling.isl.inlineSignalsRenderMode": {
          "type": "string",
          "enum": [
            "inset",
            "diagnostics"
          ],
          "enumDescriptions": [
            "%settings.isl.inlineSignalsRenderMode.enumDescriptions.inset%",
            "%settings.isl.inlineSignalsRenderMode.enumDescriptions.diagnostics%"
          ],
          "description": "%settings.isl.inlineSignalsRenderMode.description%",
          "default": "inset"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sapling",
          "title": "%sapling.command-category%",
          "icon": "resources/Sapling.svg"
        },
        {
          "id": "fbRunCommand__sapling_DOT_open-isl",
          "title": "%sapling.command-category%",
          "icon": "resources/Sapling.svg"
        }
      ]
    },
    "views": {
      "fbRunCommand__sapling_DOT_open-isl": [
        {
          "id": "sapling.isl.openButton",
          "name": "%isl.title%",
          "when": "isl.openInteractiveSmartlogShortcutEnabled && !config.sapling.isl.showInSidebar"
        }
      ],
      "sapling": [
        {
          "type": "webview",
          "id": "sapling.isl",
          "name": "%isl.title%",
          "when": "config.sapling.isl.showInSidebar"
        }
      ],
      "scm": [
        {
          "type": "webview",
          "id": "sapling.comments",
          "name": "Code Review Comments",
          "when": "isl.inlineCommentSidePanelEnabled"
        }
      ]
    },
    "commands": [
      {
        "command": "sapling.revert-file",
        "title": "%sapling.revert-file-command%",
        "category": "%sapling.command-category%",
        "icon": "$(discard)"
      },
      {
        "command": "sapling.open-isl",
        "title": "%sapling.open-isl-command%",
        "category": "%sapling.command-category%",
        "icon": {
          "light": "resources/Sapling-light.svg",
          "dark": "resources/Sapling-dark.svg"
        },
        "when": "!isl.openInteractiveSmartlogShortcutEnabled"
      },
      {
        "command": "sapling.open-file-diff-uncommitted",
        "title": "%sapling.open-diff-uncommitted-command%",
        "category": "%sapling.command-category%",
        "icon": "$(git-pull-request-go-to-changes)"
      },
      {
        "command": "sapling.open-file-diff-head",
        "title": "%sapling.open-diff-head-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.open-file-diff-stack",
        "title": "%sapling.open-diff-stack-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.open-comparison-view-uncommitted",
        "title": "%sapling.open-comparison-view-uncommitted-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.open-comparison-view-head",
        "title": "%sapling.open-comparison-view-head-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.open-comparison-view-stack",
        "title": "%sapling.open-comparison-view-stack-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.open-comparison-view",
        "title": "%sapling.open-comparison-view-command%",
        "when": false
      },
      {
        "command": "sapling.isl.focus",
        "title": "Focus Sapling ISL Sidebar"
      },
      {
        "command": "sapling.open-remote-file-link",
        "title": "Open in Code Review",
        "enablement": "sapling:hasRemoteLinkRepo"
      },
      {
        "command": "sapling.copy-remote-file-link",
        "title": "Copy Code Review Link",
        "enablement": "sapling:hasRemoteLinkRepo"
      },
      {
        "command": "sapling.open-comments",
        "title": "%sapling.open-comments-command%",
        "enablement": "isl.inlineCommentSidePanelEnabled"
      },
      {
        "command": "sapling.toggle-inline-comments",
        "title": "%sapling.toggle-inline-comments-command%",
        "enablement": "isl.inlineCommentSidePanelEnabled"
      },
      {
        "command": "sapling.debug.interpret-file-as-comments",
        "title": "Debug: Load file as inline comments JSON",
        "enablement": "sapling.isDev"
      },
      {
        "command": "sapling.open-multi-diff-file-head",
        "title": "%sapling.open-multi-diff-file-head-command%",
        "category": "%sapling.command-category%",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "sapling.worktree.switch",
        "title": "%sapling.worktree.switch-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.worktree.add",
        "title": "%sapling.worktree.add-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.worktree.remove",
        "title": "%sapling.worktree.remove-command%",
        "category": "%sapling.command-category%"
      },
      {
        "command": "sapling.worktree.rename",
        "title": "%sapling.worktree.rename-command%",
        "category": "%sapling.command-category%"
      }
    ],
    "keybindings": [
      {
        "command": "sapling.open-comparison-view-uncommitted",
        "key": "ctrl-'",
        "mac": "cmd-'",
        "when": "activeWebviewPanelId != 'sapling.isl'"
      },
      {
        "command": "sapling.open-comparison-view-head",
        "key": "ctrl-shift-'",
        "mac": "cmd-shift-'",
        "when": "activeWebviewPanelId != 'sapling.isl'"
      },
      {
        "command": "sapling.open-comments",
        "key": "alt-shift-g",
        "mac": "alt-shift-g",
        "when": "isl.inlineCommentSidePanelEnabled && activeWebviewPanelId != 'sapling.comments'"
      },
      {
        "command": "sapling.toggle-inline-comments",
        "key": "alt-shift-t",
        "mac": "alt-shift-t",
        "when": "isl.inlineCommentSidePanelEnabled"
      },
      {
        "command": "sapling.open-isl",
        "key": "ctrl-shift-i",
        "mac": "cmd-shift-i",
        "when": "isl.openInteractiveSmartlogShortcutEnabled"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sapling.open-remote-file-link",
          "when": "sapling:hasRemoteLinkRepo"
        },
        {
          "command": "sapling.copy-remote-file-link",
          "when": "sapling:hasRemoteLinkRepo"
        }
      ],
      "editor/title": [
        {
          "command": "sapling.open-isl",
          "group": "navigation@-100",
          "when": "config.sapling.isl.showOpenOrFocusButtonOnEditorTitle && isl.showButtonOnEditorTitle"
        }
      ],
      "explorer/context": [
        {
          "command": "sapling.open-remote-file-link",
          "when": "sapling:hasRemoteLinkRepo && isFileSystemResource && resourceScheme =~ /^(?!output$|vscode-(?!remote|vfs$)).*$/"
        },
        {
          "command": "sapling.copy-remote-file-link",
          "when": "sapling:hasRemoteLinkRepo && isFileSystemResource && resourceScheme =~ /^(?!output$|vscode-(?!remote|vfs$)).*$/"
        }
      ],
      "commandPalette": [
        {
          "command": "sapling.isl.focus",
          "when": "config.sapling.isl.showInSidebar"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "sapling.open-file-diff-uncommitted",
          "group": "inline",
          "when": "scmProvider == sapling && scmResourceGroup == changes"
        },
        {
          "command": "sapling.revert-file",
          "group": "inline",
          "when": "scmProvider == sapling && scmResourceGroup == changes"
        }
      ],
      "scm/title": [
        {
          "command": "sapling.open-isl",
          "group": "navigation",
          "when": "scmProvider == sapling"
        }
      ],
      "multiDiffEditor/resource/title": [
        {
          "command": "sapling.open-multi-diff-file-head",
          "group": "navigation@1",
          "when": "resourceScheme == sapling-comparison-committed"
        }
      ]
    }
  },
  "scripts": {
    "lint": "oxlint -c ../.oxlintrc.json --react-plugin --import-plugin extension webview",
    "test": "jest",
    "watch-extension": "rolldown -c rolldown.extension.config.ts --watch",
    "watch-webview": "vite",
    "build-extension": "rolldown -c rolldown.extension.config.ts --environment NODE_ENV:production",
    "build-webview": "vite build",
    "vscode:prepublish": "node ./buildForPublish.js"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "^16.11.7",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.34.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "7.0.3",
    "isl": "0.1.0",
    "jest": "29.7.0",
    "jotai": "^2.6.2",
    "mini-css-extract-plugin": "^2.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "29",
    "tsx": "^4.16.2",
    "typescript": "5.5.4",
    "unplugin": "^2.3.11",
    "vite": "^8.0.5",
    "vscode-uri": "^3.0.6"
  },
  "optionalDependencies": {
    "@vscode/vsce": "^3.7.1"
  }
}
