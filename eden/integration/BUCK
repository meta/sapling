artifacts = get_integration_test_env_and_deps()

python_unittest(
    name = "testcase",
    srcs = ["testcase_test.py"],
    env = artifacts["env"],
    network_access = network_access_utils.none(),
    supports_static_listing = False,
    deps = [
        "fbsource//third-party/pypi/parameterized:parameterized",
        "//eden/fs/py/eden:config",
        "//eden/integration/lib:lib",
    ],
)

python_unittest(
    name = "basic" + get_oss_suffix(),
    srcs = ["basic_test.py"],
    env = artifacts["env"],
    # The test drives a real EdenFS daemon over its Thrift socket. That is
    # loopback rather than the wider network, but the local forkserver brings
    # loopback down for every restricted mode, so none()/strict()/loopback are
    # all equally unusable here and only all() works both locally and on RE.
    network_access = network_access_utils.all(),
    supports_static_listing = False,
    deps = [
        "fbsource//third-party/pypi/parameterized:parameterized",
        "//eden/integration/lib:lib",
    ],
)

