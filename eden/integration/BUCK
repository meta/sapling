# Also run basic sanity tests on the non-oss build flavor.
# We don't run all the tests on both flavors since it takes a while, and the
# two build flavors are almost the same, with only some minor differences in
# the initialization code.
full_artifacts = get_test_env_and_deps("")

python_integration_test(
    name = "basic",
    srcs = [
        "basic_test.py",
    ],
    env = full_artifacts["env"],
    supports_static_listing = False,
    deps = [
        "//eden/integration/lib:lib",
    ],
)

python_unittest(
    name = "use_case",
    srcs = ["use_case_test.py"],
    env = full_artifacts["env"],
    network_access = network_access_utils.all(),
    supports_static_listing = False,
    deps = [
        "//eden/integration/lib:lib",
    ],
)

python_unittest(
    name = "du",
    srcs = ["du_test.py"],
    env = artifacts["env"],
    network_access = network_access_utils.all(),
    supports_static_listing = False,
    deps = [
        "//eden/integration/lib:lib",
    ],
)

python_unittest(
    name = "remove_test",
    srcs = ["remove_test.py"],
    env = artifacts["env"],
    network_access = network_access_utils.all(),
    supports_static_listing = False,
    deps = [
        "fbsource//third-party/pypi/parameterized:parameterized",
        "//eden/integration/lib:lib",
    ],
)

python_unittest(
    name = "readdir_cookies_break_across_checkout",
    srcs = ["readdir_cookies_break_across_checkout_test.py"],
    # The cookie collision is a POSIX readdir/NFS behavior; Windows PrjFS
    # enumeration does not reproduce it, so the bug-asserting test fails there.
    compatible_with = [
        "ovr_config//os:linux",
        "ovr_config//os:macos",
    ],
    env = artifacts["env"],
    network_access = network_access_utils.all(),
    supports_static_listing = False,
    deps = [
        "//eden/integration/lib:lib",
    ],
)

http_artifacts = get_test_env_and_deps()

