LFS pointer tests
Setup repo with proper LFS configuration to test LFS pointer functionality
  $ testtool_drawdag -R repo <<'EOF'
  > F-G-H-I
  > # bookmark: I lfs_main
  > # modify: F "lfs_file.bin" regular lfs_pointer "large file content base"
  > # modify: G "lfs_file.bin" regular lfs_pointer "large file content modified"
  > # modify: H "another_lfs.bin" regular lfs_pointer "another large file content"
  > # delete: I "another_lfs.bin"
  > EOF
  F=* (glob)
  G=* (glob)
  H=* (glob)
  I=* (glob)

  $ export COMMIT_LFS_F="$F"
  $ export COMMIT_LFS_G="$G"
  $ export COMMIT_LFS_H="$H"
  $ export COMMIT_LFS_I="$I"

