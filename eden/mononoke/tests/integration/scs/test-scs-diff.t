  $ . "${TEST_FIXTURES}/library.sh"

Setup config repo:
  $ GIT_LFS_INTERPRET_POINTERS=1 setup_common_config
  $ setup_configerator_configs
  $ start_and_wait_for_mononoke_server
  $ cd "$TESTTMP"

Setup testing repo for mononoke:
  $ hg clone -q mono:repo repo --noupdate
  $ cd repo

Helper for making commit:
  $ function commit() { # the arg is used both for commit message and variable name
  >   hg commit -qAm $1 # create commit
  >   export COMMIT_$1="$(hg --debug id -i)" # save hash to variable
  > }

First two simple commits and bookmark:
  $ echo -e "a\nb\nc\nd\ne" > a
  $ commit A

  $ echo -e "a\nb\nd\ne\nf" > b
  $ commit B
  $ hg push --to BOOKMARK_B --create -q

A commit with a file change and binary file
  $ echo -e "b\nc\nd\ne\nf" > b
  $ echo -e "\0 10" > binary
  $ commit C

A commit with file move and copy
  $ hg update -q $COMMIT_B
  $ hg move a moved_a
  $ echo x >> moved_a
  $ hg cp b copied_b
  $ commit D

A commit that adds things in two different subdirectories
  $ mkdir dir_a dir_b
  $ hg move moved_a dir_a/a
  $ echo x >> dir_a/a
  $ echo y > dir_b/y
  $ hg add dir_b/y
  $ commit E

Additional commits for comprehensive metadata diff testing
  $ hg update -q $COMMIT_B

Create an executable file
  $ echo -e "#!/bin/bash\necho hello" > script.sh
  $ chmod +x script.sh
  $ hg add script.sh
  $ commit F

Create a symlink
  $ ln -s script.sh symlink_to_script
  $ hg add symlink_to_script
  $ commit G

Create files with generated annotations
  $ cat > generated_file.py << 'EOF'
  > # @generated
  > # This file is automatically generated, do not edit
  > def auto_function():
  >     return "generated"
  > EOF
  $ hg add generated_file.py
  $ commit H

  $ cat > partially_generated.py << 'EOF'
  > # @partially-generated
  > # This file has both generated and manual sections
  > def auto_function():
  >     return "generated"
  > # BEGIN MANUAL SECTION
  > def manual_function():
  >     return "manual"
  > # END MANUAL SECTION
  > def another_auto():
  >     return "also generated"
  > EOF
  $ hg add partially_generated.py
  $ commit I

Create an empty file
  $ touch empty_file.txt
  $ hg add empty_file.txt
  $ commit J

Create a file without trailing newline
  $ printf "no newline here" > no_newline.txt
  $ hg add no_newline.txt
  $ commit K

Create a binary file (non-UTF8)
  $ python3 -c "import sys; sys.stdout.buffer.write(b'\x00\x01\x02\x03\xff\xfe\xfd')" > binary_data.bin
  $ hg add binary_data.bin
  $ commit L

Create a non-UTF8 text file (latin1)
  $ python3 -c "print('Héllo wörld', end='')" | iconv -f utf-8 -t latin1 > latin1.txt
  $ hg add latin1.txt
  $ commit M

Create file type transition (regular to executable)
  $ hg update -q $COMMIT_B
  $ echo "regular file content" > transition_file.sh
  $ hg add transition_file.sh
  $ commit N
  $ chmod +x transition_file.sh
  $ hg commit -m "make executable"
  $ export COMMIT_O="$(hg --debug id -i)"

Create modification of generated file with manual section
  $ hg update -q $COMMIT_I
  $ cat > partially_generated.py << 'EOF'
  > # @partially-generated
  > # This file has both generated and manual sections
  > def auto_function():
  >     return "generated and modified"
  > # BEGIN MANUAL SECTION
  > def manual_function():
  >     return "manual code updated"
  > def another_manual():
  >     return "more manual code"
  > # END MANUAL SECTION
  > def another_auto():
  >     return "also generated"
  > EOF
  $ hg commit -m "update partially generated file"
  $ export COMMIT_P="$(hg --debug id -i)"

Create deletion of generated file
  $ hg rm generated_file.py
  $ hg commit -m "delete generated file"
  $ export COMMIT_Q="$(hg --debug id -i)"

Create symlink to regular file transition
  $ hg update -q $COMMIT_G
  $ hg rm symlink_to_script
  $ echo "now a regular file" > symlink_to_script
  $ hg add symlink_to_script
  $ hg commit -m "symlink to regular file"
  $ export COMMIT_R="$(hg --debug id -i)"
  $ hg push --to master_bookmark --create -r "$COMMIT_C" -q
  $ hg push --to branch_e --create -r "$COMMIT_E" -q
  $ hg push --to branch_m --create -r "$COMMIT_M" -q
  $ hg push --to branch_o --create -r "$COMMIT_O" -q
  $ hg push --to branch_q --create -r "$COMMIT_Q" -q
  $ hg push --to branch_r --create -r "$COMMIT_R" -q
  $ cd ..

start SCS server
  $ cd ..
  $ start_and_wait_for_scs_server --scuba-log-file "$TESTTMP/scuba.json"

