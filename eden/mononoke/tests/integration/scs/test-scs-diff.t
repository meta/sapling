  $ scsc diff --repo repo --paths-only --json -B BOOKMARK_B -i "$COMMIT_C" \
  >   | jq -c '[.files[] | select(.base_file.path == "b") | {base_size: .base_file.info.file_size, other_size: .other_file.info.file_size}]'
  [{"base_size":10,"other_size":10}]

  $ scsc diff --repo repo --paths-only --json --hg-commit-id "$COMMIT_B" --hg-commit-id "$COMMIT_D" \
  >   | jq -c '[.files[] | {base: .base_file.path, other: (.other_file.path // null), copy: .copy_info}] | sort_by(.base)'
