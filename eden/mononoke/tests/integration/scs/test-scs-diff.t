  $ scsc diff --repo repo --paths-only --json --hg-commit-id "$COMMIT_A" --hg-commit-id "$COMMIT_B" \
  >   | jq -c '[.files[] | select(.base_file.path == "b") | {path: .base_file.path, size: .base_file.info.file_size, is_binary: .base_file.info.is_binary, type: .base_file.type}]'
