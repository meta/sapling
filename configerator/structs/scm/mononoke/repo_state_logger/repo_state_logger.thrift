package "meta.com/scm/mononoke/repo_state_logger"

namespace py3 scm.mononoke.repo_state_logger
namespace py scm.mononoke.repo_state_logger.repo_state_logger

// A mutable counter to sample, e.g. "modern_sync". The sampled value is the
// counter's raw i64 value.
struct MutableCounterValue {
  1: string counter_name;
}

// Tip of a bookmark's update log. The sampled value is the newest
// bookmark-update-log entry id for the bookmark.
struct LatestBookmarkUpdateLogId {
  1: string bookmark;
}

union ValueSource {
  1: MutableCounterValue counter;
  2: LatestBookmarkUpdateLogId bookmark_tip;
}

// Which values to sample for one repo.
struct RepoSelection {
  1: list<ValueSource> sources;
}

// Selection of per-repo values for repo_state_logger to sample and emit
// as ODS gauges.
struct RepoStateLoggerConfig {
  // Seconds between samples. Values below 60 are clamped to 60.
  1: i64 poll_interval_secs = 60;
  // Repo ID to sampled values. Keyed by ID (not name) so selections survive
  // repo renames; the logger resolves the canonical name for emission. i64
  // (not i32) so the pending repo-ID format change needs no schema edit.
  2: map<i64, RepoSelection> repos;
}
